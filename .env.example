# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Convex
# 1. pnpm setup:convex-local            (create/select local, initialize auth, sync URLs)
# 2. pnpm dev
# 3. Run `convex run --deployment local bootstrap:resetAndSeed` for demo data.
NEXT_PUBLIC_CONVEX_URL="https://your-dev-deployment.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-dev-deployment.convex.site"
CONVEX_URL="https://your-dev-deployment.convex.cloud"
CONVEX_SITE_URL="https://your-dev-deployment.convex.site"
# Comma-separated exact web origins for cloud dev/preview deployments.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Mobile (Expo)
EXPO_PUBLIC_APP_SCHEME="ia-app"
EXPO_PUBLIC_CONVEX_URL="https://your-dev-deployment.convex.cloud"
EXPO_PUBLIC_CONVEX_SITE_URL="https://your-dev-deployment.convex.site"
EXPO_PUBLIC_UNIVERSAL_LINK_HOST="app.innovationacademy.fcsia.org"
EXPO_ACCOUNT_OWNER=""
EAS_PROJECT_ID=""
IOS_BUNDLE_IDENTIFIER="org.fcsia.app"
IOS_BUILD_NUMBER="1"
ANDROID_PACKAGE="org.fcsia.app"
ANDROID_VERSION_CODE="1"

# Web Push
# Generate with: pnpm --filter cvx exec web-push generate-vapid-keys
# If pnpm is loaded by direnv, use: direnv exec . pnpm --filter cvx exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Local app mode
NODE_ENV="development"
