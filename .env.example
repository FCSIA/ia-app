# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Convex
# 1. cd apps/convex && npx convex dev   (link or create a project)
# 2. pnpm sync:convex-env               (copies URLs into apps/web/.env.local)
# 3. npx convex env set BETTER_AUTH_SECRET "<random>"  (in apps/convex)
# 4. npx convex run bootstrap:resetAndSeed             (demo data)
NEXT_PUBLIC_CONVEX_URL="https://your-dev-deployment.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-dev-deployment.convex.site"
CONVEX_URL="https://your-dev-deployment.convex.cloud"
CONVEX_SITE_URL="https://your-dev-deployment.convex.site"

# Local app mode
NODE_ENV="development"
