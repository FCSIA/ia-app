{
  "name": "cvx",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "codegen": "convex dev --once --typecheck disable --codegen enable",
    "typecheck": "tsc -p src/tsconfig.json",
    "build": "pnpm run typecheck",
    "lint": "pnpm run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "convex deploy",
    "auth:generate": "cd src/betterAuth && auth generate -y"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "better-auth": "1.6.11",
    "convex": "1.39.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/web-push": "^3.6.4",
    "auth": "1.6.11",
    "convex-test": "0.0.53",
    "edge-runtime": "4.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
