{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "react-hooks/exhaustive-deps": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "excludedFiles": ["src/components/ui/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@radix-ui/*", "@base-ui/*"],
                "message": "Import the local components/ui adapter. Read agent-notes/WEB_UI_WORKFLOW.md before adding or changing a primitive."
              }
            ]
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "JSXOpeningElement[name.name='table']",
            "message": "Use the shared Fluid Table primitive so semantics, geometry registration, and row motion stay consistent."
          },
          {
            "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='onClick']",
            "message": "Badge is non-interactive metadata. Use a semantic shared button, toggle, or filter control."
          },
          {
            "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='aria-pressed']",
            "message": "Badge is non-interactive metadata. Use a semantic shared toggle or filter control."
          }
        ]
      }
    }
  ]
}
