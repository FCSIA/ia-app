generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  uniqueId                   String                       @unique @map("unique_id")
  firstName                  String                       @map("first_name")
  lastName                   String                       @map("last_name")
  gradeLevel                 Int?                         @map("grade_level")
  major                      Pathway?                     @map("major_pathway")
  minor                      Pathway?                     @map("minor_pathway")
  email                      String?                      @unique
  passwordHash               String?                      @map("password_hash")
  roles                      Role[]                       @default([STUDENT])
  isActive                   Boolean                      @default(true) @map("is_active")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  authoredAnnouncements      Announcement[]               @relation("AnnouncementAuthor")
  submittedAnnouncements     Announcement[]               @relation("AnnouncementSubmitter")
  approvedAnnouncements      Announcement[]               @relation("AnnouncementApprover")
  announcementReads          AnnouncementRead[]
  announcementBookmarks      AnnouncementBookmark[]
  auditEvents                AuditEvent[]
  sessions                   AuthSession[]
  channelMemberships         ClubChannelMembership[]
  mentionedInChannelMentions ClubChannelMessageMention[]  @relation("ClubChannelMentionUser")
  reactedToChannelMessages   ClubChannelMessageReaction[]
  votedInChannelPolls        ClubChannelMessagePollVote[]
  authoredChannelMessages    ClubChannelMessage[]         @relation("ClubChannelMessageAuthor")
  createdChannels            ClubChannel[]                @relation("ClubChannelCreator")
  receivedInvites            ClubInvite[]                 @relation("InviteRecipient")
  sentInvites                ClubInvite[]                 @relation("InviteSender")
  clubJoinRequests           ClubJoinRequest[]
  clubMemberships            ClubMember[]
  clubsSponsored             ClubSponsor[]
  clubTagMemberships         ClubTagMember[]
  createdTags                ClubTag[]                    @relation("ClubTagCreator")
  comments                   Comment[]
  eventApprovals             EventApproval[]
  authoredEvents             Event[]                      @relation("EventAuthor")
  flexAssignments            FlexAssignment[]
  flexRegistrations          FlexRegistration[]
  flexAttendances            FlexAttendance[]             @relation("FlexAttendanceStudent")
  markedFlexAttendances      FlexAttendance[]             @relation("FlexAttendanceMarker")
  notificationDeliveries     NotificationDelivery[]
  notificationPrefs          NotificationPreference[]
  reportedContent            Report[]                     @relation("ReportedContent")
  reports                    Report[]                     @relation("ReportSubmitter")
  createdSchoolDayBlocks     SchoolDayBlock[]             @relation("SchoolDayBlockCreator")
  friendshipRequestsReceived StudentScheduleFriend[]      @relation("StudentScheduleFriendAddressee")
  friendshipRequestsSent     StudentScheduleFriend[]      @relation("StudentScheduleFriendRequester")
  studentSchedule            StudentSchedule?
  calendarEntries            CalendarEntry[]
  wrappedSnapshots           WrappedSnapshot[]
  dashboardLayout            String[]                     @default([]) @map("dashboard_layout")

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model Course {
  id                String              @id @default(cuid())
  slug              String              @unique
  title             String
  courseNumbers     String[]            @default([]) @map("course_numbers")
  department        String
  pathway           Pathway?
  catalogSource     CourseCatalogSource @default(COURSE_CATALOG) @map("catalog_source")
  term              String?
  gradeText         String?             @map("grade_text")
  minGrade          Int?                @map("min_grade")
  maxGrade          Int?                @map("max_grade")
  prerequisitesText String?             @map("prerequisites_text") @db.Text
  summary           String?             @db.Text
  majorTopics       String?             @map("major_topics") @db.Text
  essentialSkills   String?             @map("essential_skills") @db.Text
  studentWorkload   String?             @map("student_workload")
  teacherWorkload   String?             @map("teacher_workload")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  scheduleEntries   StudentScheduleEntry[]

  @@index([department, title])
  @@index([pathway, minGrade, maxGrade])
  @@map("courses")
}

model StudentSchedule {
  id        String                 @id @default(cuid())
  userId    String                 @unique @map("user_id")
  isPublic  Boolean                @default(false) @map("is_public")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  entries   StudentScheduleEntry[]
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_schedules")
}

model StudentScheduleEntry {
  id           String          @id @default(cuid())
  scheduleId   String          @map("schedule_id")
  courseId     String?         @map("course_id")
  weekday      ScheduleWeekday
  periodNumber Int             @map("period_number")
  className    String          @map("class_name")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  course       Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  schedule     StudentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday, periodNumber])
  @@index([courseId])
  @@map("student_schedule_entries")
}

model StudentScheduleFriend {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")
  requester   User             @relation("StudentScheduleFriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("StudentScheduleFriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([status])
  @@index([requesterId, status, acceptedAt])
  @@index([addresseeId, status, acceptedAt])
  @@map("student_schedule_friends")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model SchoolDayBlock {
  id           String          @id @default(cuid())
  weekday      ScheduleWeekday
  label        String
  periodNumber Int?            @map("period_number")
  startTime    String          @map("start_time")
  endTime      String          @map("end_time")
  createdById  String          @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    User            @relation("SchoolDayBlockCreator", fields: [createdById], references: [id])

  @@index([weekday, startTime])
  @@map("school_day_blocks")
}

model Announcement {
  id             String                 @id @default(cuid())
  authorId       String                 @map("author_id")
  submittedById  String?                @map("submitted_by_id")
  approvedById   String?                @map("approved_by_id")
  title          String
  body           String
  targetType     AnnouncementTarget     @map("target_type")
  targetGrade    Int?                   @map("target_grade")
  targetPathway  Pathway?               @map("target_pathway")
  targetGrades   Int[]                  @default([]) @map("target_grades")
  targetMajorPathways Pathway[]         @default([]) @map("target_major_pathways")
  targetMinorPathways Pathway[]         @default([]) @map("target_minor_pathways")
  targetValue    String?                @map("target_value")
  clubId         String?                @map("club_id")
  allowComments  Boolean                @default(false) @map("allow_comments")
  isAdminGeneral Boolean                @default(false) @map("is_admin_general")
  status         AnnouncementStatus     @default(ACTIVE)
  expiresAt      DateTime?              @map("expires_at")
  approvedAt     DateTime?              @map("approved_at")
  rejectionNote  String?                @map("rejection_note") @db.Text
  promotedUntil  DateTime?              @map("promoted_until")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  author         User                   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  submittedBy    User?                  @relation("AnnouncementSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy     User?                  @relation("AnnouncementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  club           Club?                  @relation(fields: [clubId], references: [id])
  bookmarks      AnnouncementBookmark[]
  comments       Comment[]
  reads          AnnouncementRead[]
  keywordMatches KeywordMatch[]
  notifications  NotificationDelivery[]

  @@map("announcements")
}

model AnnouncementBookmark {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, createdAt])
  @@map("announcement_bookmarks")
}

model Comment {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  authorId       String       @map("author_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}

// ─── Clubs ────────────────────────────────────────────────────────────────────

model Club {
  id            String                 @id @default(cuid())
  name          String                 @unique
  description   String?
  logoUrl       String?                @map("logo_url")
  bannerUrl     String?                @map("banner_url")
  accentColor   String?                @map("accent_color")
  overview      String?                @db.Text
  joinPolicy    ClubJoinPolicy         @default(OPEN) @map("join_policy")
  memberLimit   Int?                   @map("member_limit")
  joinCode      String?                @map("join_code")
  joinCodeUpdatedAt DateTime?          @map("join_code_updated_at")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  announcements Announcement[]
  channels      ClubChannel[]
  invites       ClubInvite[]
  joinRequests  ClubJoinRequest[]
  members       ClubMember[]
  sponsors      ClubSponsor[]
  tags          ClubTag[]
  events        Event[]
  notifications NotificationDelivery[]

  @@map("clubs")
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String   @map("club_id")
  userId    String   @map("user_id")
  role      String?
  joinedAt  DateTime @default(now()) @map("joined_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, joinedAt])
  @@map("club_members")
}

model ClubSponsor {
  id      String   @id @default(cuid())
  clubId  String   @map("club_id")
  userId  String   @map("user_id")
  addedAt DateTime @default(now()) @map("added_at")
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_sponsors")
}

model ClubInvite {
  id          String       @id @default(cuid())
  clubId      String       @map("club_id")
  senderId    String       @map("sender_id")
  recipientId String       @map("recipient_id")
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  recipient   User         @relation("InviteRecipient", fields: [recipientId], references: [id])
  sender      User         @relation("InviteSender", fields: [senderId], references: [id])

  @@unique([clubId, recipientId])
  @@map("club_invites")
}

model ClubJoinRequest {
  id          String                @id @default(cuid())
  clubId      String                @map("club_id")
  requesterId String                @map("requester_id")
  status      ClubJoinRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requester   User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([clubId, requesterId])
  @@index([clubId, status])
  @@map("club_join_requests")
}

model ClubChannel {
  id            String                  @id @default(cuid())
  clubId        String                  @map("club_id")
  name          String
  description   String?
  visibility    ClubChannelVisibility   @default(PUBLIC)
  createdById   String                  @map("created_by_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  memberships   ClubChannelMembership[]
  messages      ClubChannelMessage[]
  club          Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("ClubChannelCreator", fields: [createdById], references: [id])
  notifications NotificationDelivery[]

  @@unique([clubId, name])
  @@index([clubId, visibility])
  @@map("club_channels")
}

model ClubChannelMembership {
  id        String      @id @default(cuid())
  channelId String      @map("channel_id")
  userId    String      @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  channel   ClubChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("club_channel_memberships")
}

model ClubTag {
  id          String                      @id @default(cuid())
  clubId      String                      @map("club_id")
  name        String
  slug        String
  createdById String                      @map("created_by_id")
  createdAt   DateTime                    @default(now()) @map("created_at")
  mentions    ClubChannelMessageMention[]
  members     ClubTagMember[]
  club        Club                        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation("ClubTagCreator", fields: [createdById], references: [id])

  @@unique([clubId, slug])
  @@map("club_tags")
}

model ClubTagMember {
  id        String   @id @default(cuid())
  tagId     String   @map("tag_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  tag       ClubTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tagId, userId])
  @@map("club_tag_members")
}

model ClubChannelMessage {
  id              String                         @id @default(cuid())
  channelId       String                         @map("channel_id")
  authorId        String                         @map("author_id")
  parentMessageId String?                        @map("parent_message_id")
  body            String
  bodyRich        Json?                          @map("body_rich")
  isPinned        Boolean                        @default(false) @map("is_pinned")
  pinnedAt        DateTime?                      @map("pinned_at")
  pollQuestion    String?                        @map("poll_question")
  pollOptions     Json?                          @map("poll_options")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  attachments     ClubChannelMessageAttachment[]
  mentions        ClubChannelMessageMention[]
  reactions       ClubChannelMessageReaction[]
  pollVotes       ClubChannelMessagePollVote[]
  author          User                           @relation("ClubChannelMessageAuthor", fields: [authorId], references: [id])
  channel         ClubChannel                    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parentMessage   ClubChannelMessage?            @relation("ClubChannelMessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         ClubChannelMessage[]           @relation("ClubChannelMessageReplies")
  notifications   NotificationDelivery[]

  @@index([channelId, parentMessageId, createdAt])
  @@index([channelId, isPinned, pinnedAt])
  @@index([authorId, createdAt])
  @@index([authorId, channelId, createdAt])
  @@map("club_channel_messages")
}

model ClubChannelMessagePollVote {
  id        String             @id @default(cuid())
  messageId String             @map("message_id")
  userId    String             @map("user_id")
  optionId  String             @map("option_id")
  createdAt DateTime           @default(now()) @map("created_at")
  message   ClubChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, optionId])
  @@map("club_channel_message_poll_votes")
}

model ClubChannelMessageAttachment {
  id        String             @id @default(cuid())
  messageId String             @map("message_id")
  fileName  String             @map("file_name")
  fileUrl   String             @map("file_url")
  mimeType  String?            @map("mime_type")
  size      Int?
  createdAt DateTime           @default(now()) @map("created_at")
  message   ClubChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("club_channel_message_attachments")
}

model ClubChannelMessageReaction {
  id        String             @id @default(cuid())
  messageId String             @map("message_id")
  userId    String             @map("user_id")
  emoji     String
  createdAt DateTime           @default(now()) @map("created_at")
  message   ClubChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId, emoji])
  @@index([userId, createdAt])
  @@index([messageId, createdAt])
  @@map("club_channel_message_reactions")
}

model ClubChannelMessageMention {
  id        String             @id @default(cuid())
  messageId String             @map("message_id")
  userId    String?            @map("user_id")
  tagId     String?            @map("tag_id")
  kind      ClubMentionKind
  token     String
  createdAt DateTime           @default(now()) @map("created_at")
  message   ClubChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tag       ClubTag?           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User?              @relation("ClubChannelMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId, userId])
  @@index([userId])
  @@map("club_channel_message_mentions")
}

// ─── Events ───────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CANCELLED
}

enum EventAttendanceStatus {
  PRESENT
  ABSENT
  TARDY
}

model EventCategory {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("event_categories")
}

model Event {
  id                       String      @id @default(cuid())
  authorId                 String      @map("author_id")
  ownerId                  String?     @map("owner_id")
  clubId                   String?     @map("club_id")
  categoryId               String?     @map("category_id")
  status                   EventStatus @default(DRAFT)
  type                     EventType   @default(GENERAL)
  title                    String
  description              String?
  location                 String?
  flyerUrl                 String?     @map("flyer_url")
  startAt                  DateTime    @map("start_at")
  endAt                    DateTime?   @map("end_at")
  registrationOpensAt      DateTime?   @map("registration_opens_at")
  registrationClosesAt     DateTime?   @map("registration_closes_at")
  allowedMajorPathways     Pathway[]   @default([]) @map("allowed_major_pathways")
  allowedMinorPathways     Pathway[]   @default([]) @map("allowed_minor_pathways")
  requiredMajorWorkshopCount Int       @default(0) @map("required_major_workshop_count")
  isInactive               Boolean     @default(false) @map("is_inactive")
  deactivatedAt            DateTime?   @map("deactivated_at")
  publishedAt              DateTime?   @map("published_at")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  author                   User             @relation("EventAuthor", fields: [authorId], references: [id])
  club                     Club?            @relation(fields: [clubId], references: [id])
  category                 EventCategory?   @relation(fields: [categoryId], references: [id])
  approvals                EventApproval[]
  calendarEntry            CalendarEntry?
  keywordMatches           KeywordMatch[]
  notificationDeliveries   NotificationDelivery[]

  @@map("events")
}

model EventApproval {
  id        String         @id @default(cuid())
  eventId   String         @map("event_id")
  sponsorId String         @map("sponsor_id")
  status    ApprovalStatus @default(PENDING)
  note      String?
  decidedAt DateTime?      @map("decided_at")
  createdAt DateTime       @default(now()) @map("created_at")
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor   User           @relation(fields: [sponsorId], references: [id])

  @@unique([eventId, sponsorId])
  @@map("event_approvals")
}

model CalendarEntry {
  id           String         @id @default(cuid())
  eventId      String?        @unique @map("event_id")
  flexFridayId String?        @unique @map("flex_friday_id")
  title        String
  description  String?
  location     String?
  startAt      DateTime       @map("start_at")
  endAt        DateTime?      @map("end_at")
  tags         String[]       @default([])
  source       CalendarSource @default(SCHOOL) @map("source")
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  flexFriday   FlexFriday?    @relation(fields: [flexFridayId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("calendar_entries")
}

model FlexFriday {
  id             String           @id @default(cuid())
  date           DateTime         @unique @db.Date
  type           FlexFridayType   @default(ALL_STUDENT)
  gradeLevel     Int?             @map("grade_level")
  pathway        Pathway?
  isSchoolDay    Boolean          @default(true) @map("is_school_day")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  sessions       FlexSession[]
  attendances    FlexAttendance[]
  calendarEntry  CalendarEntry?

  @@map("flex_fridays")
}

model FlexSession {
  id           String                @id @default(cuid())
  flexFridayId String                @map("flex_friday_id")
  title        String
  description  String?
  startTime    String                @default("13:00") @map("start_time")
  endTime      String                @default("14:30") @map("end_time")
  sessionType  FlexSessionType       @default(STUDENT_CHOICE) @map("session_type")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")
  flexFriday   FlexFriday            @relation(fields: [flexFridayId], references: [id], onDelete: Cascade)
  workshops    FlexWorkshopSession[]

  @@map("flex_sessions")
}

model FlexWorkshop {
  id                  String                @id @default(cuid())
  teacherId           String?               @map("teacher_id")
  title               String
  description         String?
  location            String?
  capacity            Int?
  targetGrades        Int[]                 @default([]) @map("target_grades")
  targetMajorPathways Pathway[]             @default([]) @map("target_major_pathways")
  targetMinorPathways Pathway[]             @default([]) @map("target_minor_pathways")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at")
  sessions            FlexWorkshopSession[]
  registrations       FlexRegistration[]
  assignments         FlexAssignment[]
  attendances         FlexAttendance[]

  @@map("flex_workshops")
}

model FlexWorkshopSession {
  id         String       @id @default(cuid())
  workshopId String       @map("workshop_id")
  sessionId  String       @map("session_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  workshop   FlexWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  session    FlexSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([workshopId, sessionId])
  @@index([sessionId])
  @@map("flex_workshop_sessions")
}

model FlexRegistration {
  id         String       @id @default(cuid())
  workshopId String       @map("workshop_id")
  studentId  String       @map("student_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  workshop   FlexWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student    User         @relation(fields: [studentId], references: [id])

  @@unique([workshopId, studentId])
  @@map("flex_registrations")
}

model FlexAssignment {
  id         String       @id @default(cuid())
  workshopId String       @map("workshop_id")
  studentId  String       @map("student_id")
  assignedBy String       @map("assigned_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  workshop   FlexWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student    User         @relation(fields: [studentId], references: [id])

  @@unique([workshopId, studentId])
  @@map("flex_assignments")
}

/// Per-workshop attendance record for a student. Each PRESENT row awards one
/// Flex Friday credit. A denormalised `flexFridayId` lets us count credits by
/// school year without walking the workshop→session→friday join.
model FlexAttendance {
  id           String               @id @default(cuid())
  workshopId   String               @map("workshop_id")
  studentId    String               @map("student_id")
  flexFridayId String               @map("flex_friday_id")
  status       FlexAttendanceStatus @default(PRESENT)
  markedById   String               @map("marked_by_id")
  markedAt     DateTime             @default(now()) @map("marked_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  workshop     FlexWorkshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  student      User                 @relation("FlexAttendanceStudent", fields: [studentId], references: [id])
  flexFriday   FlexFriday           @relation(fields: [flexFridayId], references: [id], onDelete: Cascade)
  markedBy     User                 @relation("FlexAttendanceMarker", fields: [markedById], references: [id])

  @@unique([workshopId, studentId])
  @@index([studentId, flexFridayId])
  @@index([flexFridayId])
  @@map("flex_attendances")
}

model Report {
  id             String       @id @default(cuid())
  submitterId    String       @map("submitter_id")
  contentType    ContentType  @map("content_type")
  contentId      String       @map("content_id")
  reportedUserId String?      @map("reported_user_id")
  reason         String
  status         ReportStatus @default(PENDING)
  reviewNote     String?      @map("review_note")
  reviewedAt     DateTime?    @map("reviewed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  reportedUser   User?        @relation("ReportedContent", fields: [reportedUserId], references: [id])
  submitter      User         @relation("ReportSubmitter", fields: [submitterId], references: [id])

  @@map("reports")
}

model KeywordRule {
  id        String   @id @default(cuid())
  keyword   String   @unique
  addedById String   @map("added_by_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keyword_rules")
}

model KeywordMatch {
  id             String        @id @default(cuid())
  keyword        String
  contentType    ContentType   @map("content_type")
  announcementId String?       @map("announcement_id")
  eventId        String?       @map("event_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("keyword_matches")
}

model NotificationPreference {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  category       NotificationCategory
  clubId         String?              @map("club_id")
  channelId      String?              @map("channel_id")
  announcementId String?              @map("announcement_id")
  eventId        String?              @map("event_id")
  scopeKey       String               @default("global") @map("scope_key")
  enabled        Boolean              @default(true)
  level          NotificationPreferenceLevel @default(PUSH)
  locked         Boolean              @default(false)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, scopeKey])
  @@index([userId, category, clubId])
  @@index([userId, category, channelId])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  category       NotificationCategory
  announcementId String?              @map("announcement_id")
  eventId        String?              @map("event_id")
  clubId         String?              @map("club_id")
  channelId      String?              @map("channel_id")
  messageId      String?              @map("message_id")
  title          String
  body           String
  isRead         Boolean              @default(false) @map("is_read")
  createdAt      DateTime             @default(now()) @map("created_at")
  announcement   Announcement?        @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  channel        ClubChannel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  club           Club?                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event          Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  message        ClubChannelMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_events")
}

model WrappedSnapshot {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  schoolYearStart    Int      @map("school_year_start")
  schoolYearLabel    String   @map("school_year_label")
  rangeStart         DateTime @map("range_start")
  rangeEnd           DateTime @map("range_end")
  schemaVersion      Int      @default(1) @map("schema_version")
  summary            Json
  messagesSent       Int      @default(0) @map("messages_sent")
  channelsEngaged    Int      @default(0) @map("channels_engaged")
  friends            Int      @default(0)
  clubs              Int      @default(0)
  flexCredits        Int      @default(0) @map("flex_credits")
  pathwayFlexCredits Int      @default(0) @map("pathway_flex_credits")
  reactionsReceived  Int      @default(0) @map("reactions_received")
  longestStreak      Int      @default(0) @map("longest_streak")
  generatedAt        DateTime @default(now()) @map("generated_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolYearStart])
  @@index([schoolYearStart])
  @@index([schoolYearStart, schemaVersion])
  @@index([schoolYearStart, generatedAt])
  @@index([schoolYearStart, messagesSent])
  @@index([schoolYearStart, flexCredits])
  @@index([schoolYearStart, reactionsReceived])
  @@map("wrapped_snapshots")
}

