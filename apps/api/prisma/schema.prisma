generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Roles ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  STUDENT_LEADER
  STUDENT_ADMIN
  TEACHER
  SPONSOR
  SUPPORT_STAFF
  ADMIN
  SUPER_ADMIN
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  uniqueId    String   @unique @map("unique_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  gradeLevel  String?  @map("grade_level")
  pathway     String?
  email       String?  @unique
  passwordHash String? @map("password_hash")
  role        String   @default("STUDENT")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  sessions            AuthSession[]
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  clubMemberships     ClubMember[]
  clubsSponsored      ClubSponsor[]
  sentInvites         ClubInvite[]   @relation("InviteSender")
  receivedInvites     ClubInvite[]   @relation("InviteRecipient")
  authoredEvents      Event[]        @relation("EventAuthor")
  eventApprovals      EventApproval[]
  flexRegistrations   FlexRegistration[]
  flexAssignments     FlexAssignment[]
  reports             Report[]       @relation("ReportSubmitter")
  reportedContent     Report[]       @relation("ReportedContent")
  auditEvents         AuditEvent[]
  notificationPrefs   NotificationPreference[]
  notificationDeliveries NotificationDelivery[]
  comments            Comment[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

// ─── Announcements ────────────────────────────────────────────────────────────

enum AnnouncementTarget {
  SCHOOL_WIDE
  GRADE
  PATHWAY
  CLUB
}

enum AnnouncementStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
}

model Announcement {
  id          String             @id @default(cuid())
  authorId    String             @map("author_id")
  title       String
  body        String
  targetType  AnnouncementTarget @map("target_type")
  targetValue String?            @map("target_value")
  clubId      String?            @map("club_id")
  allowComments Boolean          @default(false) @map("allow_comments")
  isAdminGeneral Boolean         @default(false) @map("is_admin_general")
  status      AnnouncementStatus @default(ACTIVE)
  expiresAt   DateTime?          @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  author    User           @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  club      Club?          @relation(fields: [clubId], references: [id])
  comments  Comment[]
  notifications NotificationDelivery[]
  keywordMatches KeywordMatch[]

  @@map("announcements")
}

model Comment {
  id             String   @id @default(cuid())
  announcementId String   @map("announcement_id")
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── Clubs ────────────────────────────────────────────────────────────────────

enum ClubMemberRole {
  MEMBER
  LEADER
}

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members       ClubMember[]
  sponsors      ClubSponsor[]
  invites       ClubInvite[]
  announcements Announcement[]
  events        Event[]

  @@map("clubs")
}

model ClubMember {
  id        String         @id @default(cuid())
  clubId    String         @map("club_id")
  userId    String         @map("user_id")
  role      ClubMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now()) @map("joined_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_members")
}

model ClubSponsor {
  id      String @id @default(cuid())
  clubId  String @map("club_id")
  userId  String @map("user_id")
  addedAt DateTime @default(now()) @map("added_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_sponsors")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ClubInvite {
  id          String       @id @default(cuid())
  clubId      String       @map("club_id")
  senderId    String       @map("sender_id")
  recipientId String       @map("recipient_id")
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sender    User @relation("InviteSender", fields: [senderId], references: [id])
  recipient User @relation("InviteRecipient", fields: [recipientId], references: [id])

  @@unique([clubId, recipientId])
  @@map("club_invites")
}

// ─── Events ───────────────────────────────────────────────────────────────────

enum EventType {
  GENERAL
  CLUB
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  authorId    String      @map("author_id")
  clubId      String?     @map("club_id")
  type        EventType   @default(GENERAL)
  status      EventStatus @default(DRAFT)
  title       String
  description String?
  location    String?
  flyerUrl    String?     @map("flyer_url")
  startAt     DateTime    @map("start_at")
  endAt       DateTime?   @map("end_at")
  publishedAt DateTime?   @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  author        User            @relation("EventAuthor", fields: [authorId], references: [id])
  club          Club?           @relation(fields: [clubId], references: [id])
  approvals     EventApproval[]
  calendarEntry CalendarEntry?
  notifications NotificationDelivery[]
  keywordMatches KeywordMatch[]

  @@map("events")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventApproval {
  id        String         @id @default(cuid())
  eventId   String         @map("event_id")
  sponsorId String         @map("sponsor_id")
  status    ApprovalStatus @default(PENDING)
  note      String?
  decidedAt DateTime?      @map("decided_at")
  createdAt DateTime       @default(now()) @map("created_at")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor User  @relation(fields: [sponsorId], references: [id])

  @@unique([eventId, sponsorId])
  @@map("event_approvals")
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEntry {
  id          String   @id @default(cuid())
  eventId     String?  @unique @map("event_id")
  title       String
  description String?
  location    String?
  startAt     DateTime @map("start_at")
  endAt       DateTime? @map("end_at")
  tags        String @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("calendar_entries")
}

// ─── Flex Friday ──────────────────────────────────────────────────────────────

enum FlexFridayType {
  ALL_STUDENT
  FRESHMAN_WORKSHOP
  PATHWAY_SPECIFIC
  TEACHER_PD
}

enum FlexSessionType {
  STUDENT_CHOICE
  TEACHER_ASSIGNED
}

model FlexFriday {
  id        String         @id @default(cuid())
  date      DateTime
  type      FlexFridayType @default(ALL_STUDENT)
  pathway   String?
  isSchoolDay Boolean      @default(true) @map("is_school_day")
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")

  sessions FlexSession[]

  @@unique([date])
  @@map("flex_fridays")
}

model FlexSession {
  id            String          @id @default(cuid())
  flexFridayId  String          @map("flex_friday_id")
  teacherId     String?         @map("teacher_id")
  title         String
  description   String?
  location      String?
  capacity      Int?
  sessionType   FlexSessionType @default(STUDENT_CHOICE) @map("session_type")
  targetPathway String?         @map("target_pathway")
  targetGrade   String?         @map("target_grade")
  createdAt     DateTime        @default(now()) @map("created_at")

  flexFriday    FlexFriday         @relation(fields: [flexFridayId], references: [id], onDelete: Cascade)
  registrations FlexRegistration[]
  assignments   FlexAssignment[]

  @@map("flex_sessions")
}

model FlexRegistration {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  studentId String   @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  session FlexSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("flex_registrations")
}

model FlexAssignment {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  studentId String   @map("student_id")
  assignedBy String  @map("assigned_by")
  createdAt DateTime @default(now()) @map("created_at")

  session FlexSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("flex_assignments")
}

// ─── Moderation ───────────────────────────────────────────────────────────────

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ContentType {
  ANNOUNCEMENT
  COMMENT
  EVENT
}

model Report {
  id            String       @id @default(cuid())
  submitterId   String       @map("submitter_id")
  contentType   ContentType  @map("content_type")
  contentId     String       @map("content_id")
  reportedUserId String?     @map("reported_user_id")
  reason        String
  status        ReportStatus @default(PENDING)
  reviewNote    String?      @map("review_note")
  reviewedAt    DateTime?    @map("reviewed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  submitter     User  @relation("ReportSubmitter", fields: [submitterId], references: [id])
  reportedUser  User? @relation("ReportedContent", fields: [reportedUserId], references: [id])

  @@map("reports")
}

model KeywordRule {
  id        String   @id @default(cuid())
  keyword   String   @unique
  addedById String   @map("added_by_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keyword_rules")
}

model KeywordMatch {
  id             String      @id @default(cuid())
  keyword        String
  contentType    ContentType @map("content_type")
  announcementId String?     @map("announcement_id")
  eventId        String?     @map("event_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("keyword_matches")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationCategory {
  SCHOOL_ANNOUNCEMENT
  CLUB_ANNOUNCEMENT
  EVENT
  FLEX_FRIDAY
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String               @map("user_id")
  category NotificationCategory
  clubId   String?              @map("club_id")
  enabled  Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, clubId])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  category       NotificationCategory
  announcementId String?              @map("announcement_id")
  eventId        String?              @map("event_id")
  title          String
  body           String
  isRead         Boolean              @default(false) @map("is_read")
  createdAt      DateTime             @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  meta       String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}
