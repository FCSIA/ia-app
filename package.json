{
  "name": "ia-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=cvx",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:mobile:tunnel": "pnpm --filter mobile dev:client:tunnel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "cvx:dev": "pnpm --filter cvx dev",
    "convex:dev": "pnpm --filter cvx dev",
    "db:generate": "pnpm --filter cvx codegen",
    "db:studio": "pnpm --filter cvx exec convex dashboard",
    "setup:convex-local": "node scripts/setup-convex-local.mjs",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:ios:refresh": "bash scripts/refresh-ios-personal-build.sh",
    "mobile:android": "pnpm --filter mobile android",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "sync:convex-env": "node scripts/sync-convex-env.mjs"
  },
  "devDependencies": {
    "sharp": "0.34.5",
    "turbo": "^2.10.9",
    "typescript": "~6.0.3",
    "vercel": "^54.21.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "convex": "1.39.1"
  }
}
