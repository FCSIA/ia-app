{
  "name": "ia-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter convex-backend codegen",
    "db:migrate": "echo 'Schema changes deploy via: pnpm convex:dev (Convex push)'",
    "db:reset": "node scripts/convex-db.mjs reset",
    "db:seed": "node scripts/convex-db.mjs seed",
    "db:seed:bootstrap": "node scripts/convex-db.mjs bootstrap",
    "db:seed:courses": "cd apps/convex && PATH=../../node_modules/.bin:$PATH convex run courses/seed:run \"{\\\"secret\\\":\\\"$BOOTSTRAP_SECRET\\\",\\\"reset\\\":true}\"",
    "db:seed:schedule": "cd apps/convex && PATH=../../node_modules/.bin:$PATH convex run schedule/seed:seedFromStaticData \"{\\\"secret\\\":\\\"$BOOTSTRAP_SECRET\\\",\\\"reset\\\":true,\\\"batchSize\\\":20}\"",
    "db:studio": "pnpm convex:dev",
    "convex:dev": "pnpm --filter convex-backend dev"
  },
  "devDependencies": {
    "turbo": "^2.8.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "@types/react": "19.0.8",
      "@types/react-dom": "19.0.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "sharp"
    ]
  },
  "dependencies": {
    "convex": "1.39.1"
  }
}
