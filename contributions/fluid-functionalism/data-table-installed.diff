+/** A semantic interaction boundary, not a menu or a filter. Controls keep
+ * their own events, including events bubbling through React portals. */
+function DataTableControls({ className, ...props }: ComponentPropsWithRef<"span">) {
+  return <span {...props} data-slot="data-table-controls" className={cn("inline-flex items-center gap-1 [td_&]:-my-(--table-cell-py)", className)} />;
+}
+
+interface DataTableColumnHeaderContextValue {
+  state: { canSort: boolean; sorted: false | "asc" | "desc" };
+  actions: {
+    onSort: (event: unknown) => void;
+    setSort: (direction: false | "asc" | "desc", multi?: boolean) => void;
+  };
+  meta: { title: string; icon?: IconComponent };
+}
+const ColumnHeaderContext = createContext<DataTableColumnHeaderContextValue | null>(null);
+function useDataTableColumnHeader() {
+  const value = useContext(ColumnHeaderContext);
+  if (!value) throw new Error("useDataTableColumnHeader requires DataTableColumnHeader");
+  return value;
+}
 interface DataTableColumnHeaderProps<TData, TValue> {
   column: Column<TData, TValue>;
   title: string;
   className?: string;
+  /** Omitted: the original sort label. Supplied: compose Label, Controls,
+   * or your own control. A render child retains the column's exact type. */
+  children?: ReactNode | ((context: { column: Column<TData, TValue>; title: string }) => ReactNode);
+}
+function DataTableColumnHeader<TData, TValue>({ column, title, className, children }: DataTableColumnHeaderProps<TData, TValue>) {
+  "use no memo";
+  const value: DataTableColumnHeaderContextValue = {
+    state: { canSort: column.getCanSort(), sorted: column.getIsSorted() },
+    actions: {
+      onSort: (event) => column.getToggleSortingHandler()?.(event),
+      setSort: (direction, multi) => {
+        if (!column.getCanSort()) return;
+        if (direction === false) column.clearSorting();
+        else column.toggleSorting(direction === "desc", multi);
+      },
+    },
+    meta: { title, icon: column.columnDef.meta?.icon },
+  };
+  return <ColumnHeaderContext.Provider value={value}>
+    {children === undefined ? <DataTableColumnHeaderLabel className={className} /> :
+      <span data-slot="data-table-column-header" className={cn("inline-flex items-center gap-1", className)}>
+        {typeof children === "function" ? children({ column, title }) : children}
+      </span>}
+  </ColumnHeaderContext.Provider>;
 }

